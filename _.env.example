# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
DB_NAME=smart_parking
# Must match API_KEY in the ESP32 sketch (sent as X-ESP32-Key header)
ESP32_API_KEY=change-me-to-a-long-random-string
# Signs login tokens. Use a long random string.
JWT_SECRET=change-me-too
# Admin account created on first startup (if it doesn't exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=Parking Admin
# Dummy price per hour (INR)
RATE_PER_HOUR=20
# Admin-only IR simulator buttons. Set false once real hardware is connected.
ENABLE_SIMULATOR=true
